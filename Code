                  <div style={{marginTop:10,display:"flex",flexDirection:"column",gap:6}}>
                    {naiList.map(n=>(
                      <div key={n.id} style={{fontSize:12,color:C.text}}><span style={{color:C.amber,fontWeight:700}}>{n.navn}</span> <span style={{color:C.grey}}>— {n.beskr}</span></div>
                    ))}
