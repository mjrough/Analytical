  const [ePir,setEpir]=useState(INIT_EPIR);
  const [eDp,setEdp]=useState(INIT_EDP);
  const [eOps,setEops]=useState(INIT_EOPS);
  const [eIcp,setEicp]=useState([]);
  const [ipb,setIpb]=useState(INIT_IPB);
  const [icp,setIcp]=useState([]);
  const [kiDone,setKiDone]=useState({});
  const [tab,setTab]=useState("DASH");
  const [showIntsum,setShowIntsum]=useState(false);
  const [newObj,setNewObj]=useState({name:"",type:"",loc:"",styrke:"",utstyr:"",aktivitet:"",kilde:"B",info:"2",disiplin:"SIGINT",notes:""});
  const [newIw,setNewIw]=useState({tekst:"",sensor:"",nai:"",status:"NORMAL",pir:"PIR-1"});
  const [newBevis,setNewBevis]=useState({tekst:"",diag:"Middels"});
  const fileInputRef=useRef(null);

  const hypoScores=useMemo(()=>{const s={};hypos.forEach(h=>{s[h.id]=bevis.reduce((a,b)=>a+(SCORE_VAL[b.scores[h.id]]||0),0);});return s;},[bevis,hypos]);
  const bestH=useMemo(()=>hypos.reduce((b,h)=>hypoScores[h.id]>(b?hypoScores[b.id]:-Infinity)?h:b,null),[hypoScores,hypos]);
  const worstH=useMemo(()=>hypos.reduce((b,h)=>hypoScores[h.id]<(b?hypoScores[b.id]:Infinity)?h:b,null),[hypoScores,hypos]);
  const fhem=useMemo(()=>hypos.find(h=>h.id!==bestH?.id&&h.id!==worstH?.id)||hypos[hypos.length-1],[hypos,bestH,worstH]);
  const carverSorted=useMemo(()=>[...carver].map(r=>({...r,sum:r.C+r.A+r.R+r.V+r.E+r.Rec})).sort((a,b)=>b.sum-a.sum),[carver]);
  const kritiske=iwItems.filter(i=>i.status==="KRITISK");
  const udekket=iwItems.filter(i=>!i.dekket);

  const kiKeys=["treningsdata","explainability","proveniens","villedning","datasilo","ttp","ach"];
  const kiLabels=["Treningsdata relevant for trusselen?","Modellen kan forklare konklusjonen?","Kildeproveniens og metadata komplett?","Kan mønster være motstanders villedning?","Treningsdata er skarp – ikke øvingsdata?","Analytiker har nok kunnskap om russisk TTP?","Output testet mot ACH?"];
  const kiActions=["Flagg bias, gjennomfør kompenseringsanalyse","Gå til manuell analyse – ikke bruk i målprosess","Innhent manglende metadata før bruk","Gjennomfør Red Team-øvelse","Verifiser data-silo-integritet","Konsulter fagekspert / doktrinedatabase","Send til ACH og gjennomfør scoring"];
  const kiDoneCount=kiKeys.filter(k=>kiDone[k]).length;
  const kiOk=kiDoneCount===kiKeys.length;

  const generateICP=useCallback(()=>{
    const sensorFor=(iw)=>{const s=(iw.sensor||"").toUpperCase();
      if(s.includes("HUMINT"))return["HUMINT (EREG)","UAV-Eskadron"];
      if(s.includes("SIGINT")||s.includes("ELINT"))return["SIGINT Bn EK","Finsk SIGINT"];
      if(s.includes("SAR")||s.includes("IMINT"))return["SAR-satellitt","Alliert IMINT"];
      if(s.includes("MDA"))return["MDA kystovervåking","Alliert IMINT"];
      if(s.includes("OSINT"))return["OSINT (alliert)"];
      return["SAR-satellitt","SIGINT Bn EK"];};
    const ltiovFor=(iw)=>iw.status==="KRITISK"?"D-3 18:00Z":iw.status==="FORHØYET"?"D-5 06:00Z":"Løpende";
    // EEI/IR — bryt hver SIR ned i konkrete informasjonskrav (hva, hvor, når, hvor mange)
    const eeiFor=(iw)=>{
      const t=(iw.tekst||"").toLowerCase();
      const base=[];
      if(t.includes("rekognosering")) base.push("Antall og type rekognoseringselementer langs grensen","Bevegelsesmønster og tidspunkt for rekognosering","Tilknytning til overordnet avdeling");
      else if(t.includes("fartøy")||t.includes("barents")) base.push("Antall, type og klasse fartøy","Kurs, fart og sannsynlig destinasjon","Avvik fra normalt seilingsmønster");
      else if(t.includes("em-signatur")||t.includes("em ")||t.includes("signatur")) base.push("Frekvensbånd og emitterkarakteristikk","Geolokasjon av emitter (DF-fiks)","Korrelasjon mot kjent russisk systembibliotek");
      else if(t.includes("informasjonspåvirkning")||t.includes("narrativ")) base.push("Plattformer og kanaler benyttet","Målgruppe og narrativinnhold","Attribusjon til statlig/proxy-aktør");
      else if(t.includes("sf")||t.includes("spesialstyrke")||t.includes("klargjøring")) base.push("Lokasjon og styrke på SF-element","Logistikk- og innsettingsforberedelser","Sannsynlig oppdragstype og tidsvindu");
      else if(t.includes("logistikk")) base.push("Volum og type forsyninger","Oppmarsj- og lagringsområder","Endring i logistikktempo over tid");
      else base.push("Bekreftelse av observasjon (positiv ID)","Lokasjon, styrke og aktivitet","Endring over tid mot normalbilde");
      return base;
    };
    const targets=iwItems.filter(i=>!i.dekket||i.status==="KRITISK");
    const rows=targets.map(iw=>({id:uid(),pir:iw.pir,sir:iw.tekst,eei:eeiFor(iw),nai:iw.nai,sensors:sensorFor(iw).join(" / "),method:"3R: redundans + miks + cueing",ltiov:ltiovFor(iw),prioritet:iw.status==="KRITISK"?"1 – Kritisk":iw.dekket?"3 – Rutine":"2 – Forhøyet",iwId:iw.id}));
    rows.sort((a,b)=>a.prioritet.localeCompare(b.prioritet));
    setIcp(rows);setTab("ICP");
  },[iwItems]);

  // ── Generer fiendens ICP: hvordan motstanderen samler inn mot OSS ──
  const generateEnemyICP=useCallback(()=>{
    const enemySensorFor=(t)=>{
      t=t.toLowerCase();
      if(t.includes("sensor")||t.includes("ek-node")||t.includes("ild")) return ["Russisk SIGINT/ELINT (Kola)","Tu-214R ISR-fly","Romkapasitet (Persona/Bars-M)"];
      if(t.includes("forsterkning")||t.includes("mottak")) return ["Satellitt-IMINT","GUGI undervann (kabler/havner)","Agentnettverk (HUMINT)"];
      if(t.includes("terskel")||t.includes("respons")||t.includes("politisk")) return ["Påvirkningsapparat/OSINT","Cyber mot beslutningsnettverk","Diplomatisk rapportering"];
      return ["Russisk SIGINT","UAV-rekognosering","HUMINT/agentnett"];
    };
    const eeiFor=(p)=>{
      const t=p.tekst.toLowerCase();
      if(t.includes("gruppert")) return ["Lokasjon og styrke på norske/allierte bataljoner","Beredskapsgrad og mobiliseringstempo","Reservers plassering og fremrykningsruter"];
      if(t.includes("sensorer")||t.includes("ild")) return ["Posisjon på allierte EK-noder og radarer","Lokasjon langtrekkende ild (HIMARS o.l.)","Sensor-effektor-kjedens reaksjonstid"];
      if(t.includes("forsterkning")||t.includes("mottak")) return ["Havner/flyplasser i bruk for mottak","Tidsplan for alliert deployering","Forhåndslagre og deres bevoktning"];
      return ["Beslutningstakeres terskel og samhold","Sprekker i nordisk-alliert samordning","Hjemlig politisk vilje til respons"];
    };
    const rows=ePir.map((p,i)=>({id:uid(),epir:p.tekst,mot:p.mot,eei:eeiFor(p),sensors:enemySensorFor(p.tekst).join(" / "),ltiov:i===0?"D-2":i===1?"D-1":"D+0",prioritet:i<2?"1 – Avgjørende":"2 – Viktig"}));
    setEicp(rows);
  },[ePir]);

  const addObject=()=>{if(!newObj.name)return;setObjects(p=>[...p,{...newObj,id:uid(),tid:new Date().toISOString().slice(11,16)+"Z",x:50,y:50}]);setNewObj({name:"",type:"",loc:"",styrke:"",utstyr:"",aktivitet:"",kilde:"B",info:"2",disiplin:"SIGINT",notes:""});};
  const sendObjToAch=(o)=>{if(bevis.find(b=>b.kilde===o.id))return;setBevis(p=>[...p,{id:uid(),tekst:`${o.name} – ${o.aktivitet} [${o.disiplin}]`,scores:Object.fromEntries(hypos.map(h=>[h.id,"N"])),diag:"Middels",kilde:o.id}]);setTab("ACH");};
