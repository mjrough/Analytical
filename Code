              <div style={{marginBottom:18}}><Eyebrow color={C.amber}>Indikasjonsstatus</Eyebrow>{["KRITISK","FORHØYET"].map(s=>{const it=iwItems.filter(i=>i.status===s);if(!it.length)return null;return(<div key={s} style={{marginTop:8}}><div style={{fontSize:11,fontWeight:700,color:STATUS_C[s]}}>{s} ({it.length})</div>{it.map(i=><div key={i.id} style={{fontSize:12.5,color:C.text,paddingLeft:14,marginTop:3}}>· {i.tekst} — {i.sensor}, {i.obs}</div>)}</div>);})}</div>
              <div style={{marginBottom:18,display:"grid",gridTemplateColumns:"1fr 1fr",gap:12}}><div style={{background:C.greenDim,border:`1px solid ${C.green}55`,borderRadius:4,padding:"12px 14px"}}><Eyebrow color={C.green}>MSHEM</Eyebrow><div style={{fontFamily:SERIF,fontSize:15,color:C.cream,margin:"5px 0"}}>{bestH?.title}</div><div style={{fontSize:11,color:C.textDim}}>ACH +{bestH?hypoScores[bestH.id]:0}</div></div><div style={{background:C.redDim,border:`1px solid ${C.red}55`,borderRadius:4,padding:"12px 14px"}}><Eyebrow color={C.red}>FHEM</Eyebrow><div style={{fontFamily:SERIF,fontSize:15,color:C.cream,margin:"5px 0"}}>{fhem?.title}</div><div style={{fontSize:11,color:C.textDim}}>Uavhengig av score</div></div></div>
              {carverSorted[0]&&<div style={{marginBottom:18}}><Eyebrow color={C.gold}>Høyest prioritert mål · CARVER</Eyebrow><div style={{fontSize:13,color:C.text,marginTop:8}}>{carverSorted[0].name} — sum <span style={{color:C.green,fontWeight:700}}>{carverSorted[0].sum}/60</span></div></div>}
              {icp.length>0&&<div style={{marginBottom:18}}><Eyebrow color={C.gold}>Innhentingsplan · {icp.length} oppdrag</Eyebrow>{icp.slice(0,4).map(r=><div key={r.id} style={{fontSize:12.5,color:C.text,paddingLeft:14,marginTop:4}}>· <strong>{r.nai}</strong> — SIR: {r.sir} <span style={{color:C.grey}}>({(r.eei||[]).length} EEI · {r.sensors.split(" / ")[0]} · LTIOV {r.ltiov})</span></div>)}</div>}
              <div style={{marginBottom:18}}><Eyebrow color={C.green}>Order of Battle · {objects.length} objekter</Eyebrow>{objects.map(o=><div key={o.id} style={{fontSize:12.5,color:C.text,paddingLeft:14,marginTop:3}}>· {o.name} — {o.aktivitet} — {o.kilde}{o.info}/{o.disiplin}</div>)}</div>
              <div style={{background:kiOk?C.greenDim:C.redDim,border:`1px solid ${kiOk?C.green:C.red}44`,borderRadius:4,padding:"10px 14px",marginBottom:20}}><div style={{fontSize:12.5,color:kiOk?C.green:C.red,fontWeight:600}}>KI-kontroll: {kiOk?"✓ Godkjent – output validert":`⚠ Ikke fullstendig – ${kiDoneCount}/7 utført`}</div></div>
              <div style={{display:"flex",justifyContent:"space-between",alignItems:"center"}}><span style={{fontSize:11,color:C.grey}}>UGRADERT · {sak.dato}</span><div style={{display:"flex",gap:8}}><Btn onClick={exportIntsum}>Last ned INTSUM (.txt)</Btn><Btn onClick={()=>setShowIntsum(false)} variant="primary" style={{padding:"8px 22px"}}>Lukk</Btn></div></div>
            </div>
            <div style={{textAlign:"center",padding:"6px 0",borderTop:`1px solid ${C.gold}44`}}><span style={{fontSize:10,letterSpacing:"0.4em",color:C.gold,fontWeight:700}}>T J E N S T L I G</span></div>
          </div>
        </div>
      )}

      <style>{`@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.55}}input[type=number]::-webkit-inner-spin-button{-webkit-appearance:none}::-webkit-scrollbar{width:7px;height:7px}::-webkit-scrollbar-track{background:${C.bgDeep}}::-webkit-scrollbar-thumb{background:${C.border};border-radius:3px}select option{color:${C.text}}`}</style>
    </div>
  );
}
