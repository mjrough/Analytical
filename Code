    L.push("");
    L.push("TJENSTLIG");
    const blob=new Blob([L.join("\n")],{type:"text/plain;charset=utf-8"});
    const url=URL.createObjectURL(blob);
    const a=document.createElement("a");
    const safe=(sak.title||"sak").replace(/[^a-z0-9æøå]+/gi,"_").slice(0,40);
