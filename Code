function Eyebrow({children,color=C.gold}){return <div style={{fontSize:10,fontWeight:700,letterSpacing:"0.22em",color,textTransform:"uppercase",fontFamily:SANS}}>{children}</div>;}
function Pill({label,color}){const c=color||STATUS_C[label]||C.gold;return <span style={{fontSize:9,fontWeight:700,letterSpacing:"0.1em",padding:"2px 8px",borderRadius:2,background:c+"22",color:c,border:`1px solid ${c}55`,fontFamily:SANS,textTransform:"uppercase"}}>{label}</span>;}
function GoldRule({w=48,style={}}){return <div style={{height:2,width:w,background:C.gold,...style}}/>;}
function Sec({eyebrow,title,sub,children}){return(<section style={{marginBottom:34}}><div style={{marginBottom:18}}><Eyebrow>{eyebrow}</Eyebrow><h2 style={{margin:"6px 0 4px 0",fontSize:26,fontWeight:400,color:C.cream,fontFamily:SERIF,letterSpacing:"0.01em"}}>{title}</h2>{sub&&<div style={{fontSize:13,color:C.textDim,fontFamily:SANS,fontStyle:"italic"}}>{sub}</div>}<GoldRule style={{marginTop:12}}/></div>{children}</section>);}
function Input({value,onChange,placeholder,style={}}){return <input value={value} onChange={e=>onChange(e.target.value)} placeholder={placeholder} style={{background:C.bgDeep,border:`1px solid ${C.border}`,borderRadius:3,padding:"7px 11px",color:C.text,fontSize:13,outline:"none",fontFamily:SANS,...style}} onFocus={e=>e.target.style.borderColor=C.gold} onBlur={e=>e.target.style.borderColor=C.border}/>;}
function TArea({value,onChange,style={}}){return <textarea value={value} onChange={e=>onChange(e.target.value)} style={{background:C.bgDeep,border:`1px solid ${C.border}`,borderRadius:3,padding:"10px 13px",color:C.text,fontSize:13,outline:"none",fontFamily:SANS,lineHeight:1.65,resize:"vertical",width:"100%",boxSizing:"border-box",...style}} onFocus={e=>e.target.style.borderColor=C.gold} onBlur={e=>e.target.style.borderColor=C.border}/>;}
function Select({value,onChange,options,style={}}){return <select value={value} onChange={e=>onChange(e.target.value)} style={{background:C.panelSolid,border:`1px solid ${C.border}`,borderRadius:3,padding:"7px 10px",color:C.text,fontSize:13,outline:"none",fontFamily:SANS,cursor:"pointer",...style}}>{options.map(o=><option key={o.value||o} value={o.value||o} style={{background:C.panelSolid}}>{o.label||o}</option>)}</select>;}
function Btn({children,onClick,variant="ghost",style={}}){const base={fontFamily:SANS,cursor:"pointer",fontWeight:600,fontSize:12,borderRadius:3,padding:"7px 15px",transition:"all 0.12s",letterSpacing:"0.04em"};const v={primary:{background:C.gold,color:C.ink,border:"none"},danger:{background:"transparent",color:C.red,border:`1px solid ${C.red}44`},ghost:{background:"transparent",color:C.goldPale,border:`1px solid ${C.border}`}};return <button onClick={onClick} style={{...base,...v[variant],...style}}>{children}</button>;}
function ScoreBtn({val,current,onChange}){const a=current===val;return <button onClick={()=>onChange(val)} style={{fontFamily:SANS,cursor:"pointer",fontWeight:700,fontSize:12,width:34,height:27,borderRadius:3,border:"none",transition:"all 0.1s",background:a?SCORE_COL[val]+"2E":C.bgDeep,color:a?SCORE_COL[val]:C.grey,outline:a?`1px solid ${SCORE_COL[val]}`:"none"}}>{val}</button>;}
function Card({children,style={},accent}){return <div style={{background:C.card,border:`1px solid ${C.border}`,borderRadius:5,borderTop:accent?`2px solid ${accent}`:undefined,padding:"15px 17px",...style}}>{children}</div>;}

