                  <Eyebrow>Plotted enheter</Eyebrow>
                  <div style={{marginTop:10,display:"flex",flexDirection:"column",gap:7}}>
                    {objects.map(o=>(
                      <div key={o.id} style={{display:"flex",justifyContent:"space-between",alignItems:"center",gap:8,padding:"7px 9px",background:C.bgDeep,borderRadius:3,border:`1px solid ${placing===o.id?C.gold:C.dimBorder}`}}>
