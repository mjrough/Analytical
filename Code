                        <text x={cx} y={cy+0.9} fill={C.cream} fontSize="2.2" fontFamily="sans-serif" textAnchor="middle" fontWeight="700">{typeSym(o.type)}</text>
                        <text x={cx} y={cy+5} fill={C.text} fontSize="1.7" fontFamily="sans-serif" textAnchor="middle">{o.name.length>16?o.name.slice(0,15)+"…":o.name}</text>
                      </g>
                    );
                  })}
                </svg>
                <div style={{display:"flex",gap:14,flexWrap:"wrap",padding:"10px 14px",borderTop:`1px solid ${C.border}`,fontSize:11,color:C.textDim}}>
                  <span><span style={{color:C.red}}>▭</span> Fiendtlig enhet</span>
                  <span><span style={{color:C.amber}}>◌</span> NAI</span>
                  <span><span style={{color:C.gold}}>┊</span> Riksgrense</span>
                  <span style={{marginLeft:"auto"}}>▭ Manøver · ● Ild · ◆ C2 · ▲ SF</span>
                </div>
              </div>

              {/* SIDEBAR */}
              <div style={{display:"flex",flexDirection:"column",gap:10}}>
