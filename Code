        if(!window.confirm("Importer saken? Dette erstatter alt gjeldende arbeid i appen."))return;
        if(d.sak)setSak(d.sak);
        if(d.objects)setObjects(d.objects);
        if(d.iwItems)setIw(d.iwItems);
        if(d.hypos)setHypos(d.hypos);
        if(d.bevis)setBevis(d.bevis);
        if(d.carver)setCarver(d.carver);
        if(d.naiList)setNai(d.naiList);
        if(d.ePir)setEpir(d.ePir);
        if(d.eDp)setEdp(d.eDp);
        if(d.eOps)setEops(d.eOps);
        if(d.eIcp)setEicp(d.eIcp);
        if(d.ipb)setIpb(d.ipb);
        if(d.icp)setIcp(d.icp);
        if(d.kiDone)setKiDone(d.kiDone);
        setTab("IPOE");
